# --- Provider API keys (set the one matching QA_AGENT_MODEL below) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here

# --- Model selection (LiteLLM model string) ---
# Examples:
#   anthropic/claude-sonnet-4-6
#   anthropic/claude-haiku-4-5-20251001   (cheapest Claude)
#   gemini/gemini-2.5-flash               (cheapest overall — new accounts)
#   gemini/gemini-1.5-flash               (legacy fallback)
QA_AGENT_MODEL=gemini/gemini-2.5-flash

# Optional: set headless mode for Playwright (default: true)
# QA_AGENT_HEADLESS=true

# Optional: directory for generated tests and reports
# QA_AGENT_OUTPUT_DIR=generated_tests
# QA_AGENT_REPORT_DIR=reports

# ===========================================================================
# API / dashboard service (qa-agent-api) — only needed for the web app.
# The CLI ignores everything below.
# ===========================================================================

# Postgres connection (Supabase). Use the sync psycopg driver. SQLite is the
# default for local dev/tests.
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
# QA_AGENT_DATABASE_URL=sqlite:///qa_agent.db

# Fernet key (urlsafe base64, 32 bytes) for encrypting BYOK keys + auth
# sessions at rest. Generate with:
#   python -c "from qa_agent.api.crypto import generate_key; print(generate_key())"
# QA_AGENT_SECRET_KEY=

# Supabase auth — verifies the dashboard's JWTs.
# SUPABASE_JWT_SECRET=
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Comma-separated dashboard origins allowed by CORS.
# QA_AGENT_CORS_ORIGINS=http://localhost:3000

# Per-user quotas / abuse control.
# QA_AGENT_MAX_CONCURRENT_RUNS=2
# QA_AGENT_DAILY_RUN_CAP=50
# QA_AGENT_PARALLELISM=4

# Local-only escape hatch: disable auth and treat every request as one user.
# NEVER enable in production.
# QA_AGENT_AUTH_DISABLED=1
