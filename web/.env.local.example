# URL of the qa-agent FastAPI service (the Python API).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project (dashboard auth). Leave both blank to run the dashboard in
# local no-auth mode against an API started with QA_AGENT_AUTH_DISABLED=1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
