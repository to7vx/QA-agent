# =============================================================================
# Project outputs
# =============================================================================

# Playwright runtime artifacts
playwright/.auth/
test-results/
playwright-report/
screenshots/

# Generated test files
# DECISION PENDING: for portfolio, we may want to commit a curated sample run.
# For now, ignore all generated tests. When ready to showcase, explicitly
# `git add generated_tests/sample_run.py` and remove from this pattern.
generated_tests/*.py

# Reports — ignore bulk output, allow one curated example
reports/*.md
reports/raw_results.json
reports/healing_stats.json
reports/*/
# To commit a sample report: git add -f reports/sample_report.md
!reports/sample_report.md

# Dashboard frontend build tooling
web/node_modules/
web/tsconfig.tsbuildinfo
# NOTE: src/qa_agent/dashboard/static/ (built bundle) IS committed on purpose,
# so Python-only users never need Node.

